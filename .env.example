PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
# Required for database operations. Keep the key on the server.
SUPABASE_URL=
SUPABASE_KEY=
# Set a random, persistent value of at least 32 characters for production.
SESSION_SECRET=
# Optional SMTP configuration for password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Explicit local testing only. Never enable this in production.
SHOW_CODE_FALLBACK=false
